{
  "name": "vp-nix",
  "version": "1.3.0",
  "description": "Minimal pnpm project that pins the published vite-plus CLI so Nix can fetch its dependency tree offline.",
  "private": true,
  "dependencies": {
    "vite-plus": "1.3.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    }
  }
}
